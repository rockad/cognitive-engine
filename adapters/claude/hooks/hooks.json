{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$COGNITIVE_ENGINE_HOME/packages/jev/src/hook.ts\" claude",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$COGNITIVE_ENGINE_HOME/packages/jev/src/hook.ts\" claude",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Agent|Task|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$COGNITIVE_ENGINE_HOME/packages/jev/src/advisor-hook.ts\" pre-tool-use",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$COGNITIVE_ENGINE_HOME/packages/jev/src/record-hook.ts\" PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$COGNITIVE_ENGINE_HOME/packages/jev/src/record-hook.ts\" SessionStart",
            "timeout": 5
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$COGNITIVE_ENGINE_HOME/packages/jev/src/record-hook.ts\" PostModelSwitch",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$COGNITIVE_ENGINE_HOME/packages/jev/src/advisor-hook.ts\" user-prompt-submit",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
